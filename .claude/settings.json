{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 ./scripts/guard_edits.py" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(python3 scripts/approve.py *)",
      "Bash(python scripts/approve.py *)"
    ]
  }
}
